# PowerGym Management environment template
# Copy this file to .env and replace all placeholders before running in production.

NODE_ENV=development
PORT=3000

# Required in production. Use a long random value.
JWT_SECRET=replace_with_a_long_random_secret

# Initial bootstrap admin. The password is hashed when /api/admin-setup is called.
SUPER_ADMIN_EMAIL=super_admin@powergym.local
SUPER_ADMIN_PASSWORD=replace_with_emergency_bootstrap_password
POWERGYM_INITIAL_ADMIN_PASSWORD=replace_with_unique_initial_admin_password

# MySQL connection. No real credentials should be committed.
# Preferred variable names:
DATABASE_HOSTNAME=localhost
DATABASE_PORT=3306
DATABASE_USER_NAME=powergym_user
DATABASE_PASSWORD=replace_with_database_password
DATABASE_NAME=powergym
DATABASE_CONNECTION_LIMIT=10
DATABASE_CONNECT_TIMEOUT_MS=10000

# Compatibility aliases also supported by the server and migration script:
DB_HOST=localhost
DB_PORT=3306
DB_USER=powergym_user
DB_PASSWORD=replace_with_database_password
DB_NAME=powergym
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Optional hardening
# In production, /api/admin-setup requires this token when bootstrapping the first admin.
ADMIN_SETUP_TOKEN=replace_with_one_time_setup_token

# Optional API cache and performance tuning for low-risk read endpoints.
API_CACHE_TTL_MS=30000
DASHBOARD_API_MAX_ROWS=5000
TABLE_EXISTS_CACHE_TTL_MS=60000
SLOW_QUERY_LOG_MS=750
SLOW_RESPONSE_LOG_MS=1500
# Phase 6 observability logging controls.
# LOG_LEVEL supports: debug, info, warn, error.
LOG_LEVEL=info
# Set false to suppress per-request structured JSON console logs.
LOG_API_REQUESTS=true

# Phase 1 implementation roadmap controls
# The legacy /api/records/* compatibility API is deprecated.
# Non-production keeps it enabled for migration work unless DISABLE_COMPAT_RECORDS_API=true.
# Production requires ENABLE_COMPAT_RECORDS_API=true as a temporary, explicit migration opt-in.
ENABLE_COMPAT_RECORDS_API=false
DISABLE_COMPAT_RECORDS_API=false

# Delivery 8 support/contact channels
SUPPORT_EMAIL=support@powergym.local
SUPPORT_PHONE=+96100000000
SUPPORT_WHATSAPP=+96100000000
SUPPORT_OFFICE_HOURS=Mon - Fri: 9:00 AM - 6:00 PM

# Phase 1 hardening controls
# Comma-separated allowed browser origins for mutating API requests.
ALLOWED_ORIGINS=http://localhost:3000
# Only these origins may be fetched as remote QR e-card background images.
ECARD_IMAGE_ALLOWED_ORIGINS=
ECARD_IMAGE_MAX_BYTES=2097152
ECARD_IMAGE_FETCH_TIMEOUT_MS=4000
# Keep false in production until a one-time token reset workflow is configured.
ALLOW_LEGACY_PASSWORD_RESET=false

# Phase 5 tokenized password reset
# Use a long random value different from JWT_SECRET when possible.
PASSWORD_RESET_TOKEN_PEPPER=replace_with_a_long_random_reset_token_pepper
# Token lifetime in minutes. The server clamps this between 5 and 120.
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Development only: set false to avoid returning preview tokens from reset request responses.
PASSWORD_RESET_EXPOSE_DEV_TOKEN=true

# Phase 6 password reset delivery
# Use a real public URL so email/SMS links open the correct reset screen.
PASSWORD_RESET_PUBLIC_BASE_URL=https://your-domain.example
PASSWORD_RESET_PATH=/login
# Comma-separated delivery channels: email, sms, or email,sms.
PASSWORD_RESET_DELIVERY_CHANNELS=email

# Email delivery provider: disabled, console, webhook, sendgrid.
PASSWORD_RESET_EMAIL_PROVIDER=disabled
PASSWORD_RESET_EMAIL_FROM=no-reply@your-domain.example
PASSWORD_RESET_EMAIL_FROM_NAME=PowerGym Management
PASSWORD_RESET_EMAIL_WEBHOOK_URL=
PASSWORD_RESET_EMAIL_WEBHOOK_SECRET=
SENDGRID_API_KEY=

# SMS delivery provider: disabled, console, webhook, twilio.
# To use SMS per account, set admin_users.reset_phone and reset_delivery_channel='sms' or PASSWORD_RESET_DELIVERY_CHANNELS=sms.
PASSWORD_RESET_SMS_PROVIDER=disabled
PASSWORD_RESET_SMS_FROM=
PASSWORD_RESET_SMS_WEBHOOK_URL=
PASSWORD_RESET_SMS_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Phase 11 deployment operations
# Used by db:backup, deploy:release and deploy:smoke.
DATABASE_BACKUP_DIR=backups
DATABASE_BACKUP_RETENTION_DAYS=30
DEPLOY_BASE_URL=https://your-domain.example
DEPLOY_SMOKE_TIMEOUT_MS=8000
# Optional bearer token for authenticated smoke endpoints such as /api/db-health.
DEPLOY_SMOKE_AUTH_TOKEN=
# Optional smoke login for cookie-authenticated endpoints. Keep the password only in the uncommitted .env file.
DEPLOY_SMOKE_LOGIN_EMAIL=
DEPLOY_SMOKE_LOGIN_PASSWORD=

# Phase 12 - Managed backup restore controls
DATABASE_RESTORE_API_ENABLED=false
DATABASE_RESTORE_ALLOW_PRODUCTION=false
DATABASE_RESTORE_ALLOW_DESTRUCTIVE=false
# Optional Windows/local MySQL client binary paths. Use these if mysqldump/mysql are not in PATH.
# Example: C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe
MYSQLDUMP_PATH=
# Example: C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe
MYSQL_PATH=


# Isolated restore rehearsal target. Must differ from the application database.
REHEARSAL_DATABASE_HOSTNAME=
REHEARSAL_DATABASE_PORT=3306
REHEARSAL_DATABASE_USER_NAME=
REHEARSAL_DATABASE_PASSWORD=
REHEARSAL_DATABASE_NAME=powergym_restore_test

# Phase 7 security hardening controls
# Use a long, random JWT secret in production. Placeholder/default wording is rejected.
# Production admin setup is disabled unless this is explicitly true and ADMIN_SETUP_TOKEN is set.
ADMIN_SETUP_ENABLED=false
# Keep false in production. Intended only for emergency bootstrap during initial deployment.
ALLOW_ENV_BOOTSTRAP_LOGIN=false
# API docs are hidden in production unless explicitly enabled.
ENABLE_API_DOCS_IN_PRODUCTION=false
# Optional fixed Google OAuth callback URL. Must end with /api/auth/google/callback.
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/api/auth/google/callback

# Phase 10 / API-first and production evidence
API_PUBLIC_BASE_URL=https://your-domain.example
PUBLIC_APP_ORIGIN=https://your-domain.example
# Set false only for a trusted HTTP/IP-only internal deployment.
SESSION_COOKIE_SECURE=true
